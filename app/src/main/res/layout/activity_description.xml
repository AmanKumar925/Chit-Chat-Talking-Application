<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!--
        Exact status-bar area.
        Its height is set dynamically in DescriptionActivity.java.
        This prevents the toolbar title from being cut.
    -->
    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/matteblack" />

    <!-- ========================================================= -->
    <!-- TOOLBAR                                                    -->
    <!-- ========================================================= -->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/desc_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_below="@id/status_bar_space"
        android:background="@color/matteblack"
        android:elevation="4dp"
        android:minHeight="?attr/actionBarSize" />

    <!-- ========================================================= -->
    <!-- CONTENT                                                     -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/description_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/desc_toolbar"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================================================= -->
            <!-- POST TITLE                                         -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/desc_activity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Post"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ================================================= -->
            <!-- POST IMAGE                                         -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/desc_activity_image"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/default_image"
                android:visibility="gone" />

            <!-- ================================================= -->
            <!-- DESCRIPTION                                        -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/desc_activity_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No description available."
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <!-- ================================================= -->
            <!-- AUDIO BUTTON                                       -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/desc_activity_audio_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="🔊 Listen"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>